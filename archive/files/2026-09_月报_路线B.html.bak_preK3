/* ===== 表格基础样式 - 内容自适应 ===== */
table {
  width: 100%;
  border-collapse: collapse;
  margin: 15px 0;
  font-size: 13px;
  background: #fff;
  border: 1.5px solid #b0bec5;
  table-layout: auto;  /* 内容自适应 */
}
th {
  padding: 10px 8px;
  text-align: center;
  font-weight: 600;
  color: #1a3a5c;
  border: 1px solid #b0bec5;
  background: #e3f2fd;
  vertical-align: middle;
  white-space: normal;     /* 允许表头换行 */
  word-break: keep-all;    /* 中文不拆词 */
}
td {
  padding: 8px 8px;
  border: 1px solid #e0e0e0;
  text-align: center;      /* 默认居中 */
  vertical-align: middle;
  white-space: nowrap;     /* 默认不换行 */
  word-break: keep-all;
}
/* 长文本列 - 允许换行+左对齐（允许任意断行防溢出） */
td.td-wrap, th.th-wrap {
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  line-height: 1.6;
}
tr:nth-child(even) { background: #fafafa; }
tr:hover { background: #f5f9ff; }

/* ===== 专用列样式（供class使用） ===== */
/* 序号列 */
td.td-num, th.th-num {
  text-align: center;
  width: 40px;
  white-space: nowrap;
}
/* 日期列 */
td.td-date, th.th-date {
  text-align: center;
  white-space: nowrap;
  min-width: 85px;
}
/* 金额列 */
td.td-amount, th.th-amount {
  text-align: right;
  white-space: nowrap;
  min-width: 90px;
}
/* 状态列 */
td.td-status, th.th-status {
  text-align: center;
  white-space: nowrap;
  width: 70px;
}
/* 招采单位列 - 允许换行（允许任意断行防长名称撑破表格） */
td.td-org, th.th-org {
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  min-width: 120px;
}
/* 项目名称列 - 允许换行 */
td.td-project, th.th-project {
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  min-width: 160px;
}
/* 厂商列 - 允许换行（min-width 保证一行可容纳5-6个汉字） */
td.td-vendor, th.th-vendor {
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  min-width: 6em;
}
/* 居中对齐列 */
td.td-center, th.th-center {
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}
/* 左对齐列（允许换行） */
td.td-left, th.th-left {
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  line-height: 1.6;
}

/* ===== 信托IT系统表格 ===== */
table.it-table {
  font-size: 12px;
}
table.it-table th {
  padding: 8px 6px;
  font-size: 12px;
}
table.it-table td {
  padding: 6px 6px;
  font-size: 12px;
}
table.it-table th:first-child,
table.it-table td:first-child {
  text-align: center;
  white-space: nowrap;
  width: 65px;
  min-width: 65px;
}

/* ===== 行业数据表格 ===== */
table.data-table {
  font-size: 13px;
}
table.data-table th {
  text-align: center;
}
table.data-table td {
  text-align: center;
  white-space: normal;
  word-break: keep-all;
}
table.data-table td:nth-child(2) {
  text-align: right;  /* 数值列右对齐 */
  white-space: nowrap;
}
/* 封底 */
.footer {
  background: linear-gradient(135deg, #1a3a5c 0%, #2d5f8a 50%, #1a3a5c 100%);
  color: #fff;
  padding: 60px 50px;
  text-align: center;
  margin-top: 60px;
}
.footer .footer-org {
  font-size: 28px;
  font-weight: 600;
  letter-spacing: 2px;
  margin-bottom: 20px;
}
.footer .footer-date {
  font-size: 16px;
  color: rgba(255,255,255,0.7);
  letter-spacing: 1px;
  margin-bottom: 30px;
}
.footer .footer-line {
  width: 100%;
  max-width: 600px;
  height: 1px;
  background: rgba(255,255,255,0.2);
  margin: 0 auto 25px;
}
/* 封底归档入口（V336.1起，2026-08-23用户确认）：封面入口移至封底，幽灵按钮样式 */
.footer .footer-archive { margin: 0 auto 22px; }
.footer .footer-archive a {
  display: inline-block;
  padding: 8px 22px;
  border: 1px solid rgba(255,255,255,0.38);
  border-radius: 20px;
  color: rgba(255,255,255,0.88);
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 1px;
  transition: background .2s, border-color .2s;
}
.footer .footer-archive a:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.6); }

.footer .footer-disclaimer {
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  line-height: 2;
  max-width: 700px;
  margin: 0 auto;
}

/* 统计框（内容一律左对齐，多行明细居中难读） */
.stat-box {
  background: linear-gradient(135deg, #e8f0fe 0%, #f0f7ff 100%);
  border-radius: 8px;
  padding: 20px 25px;
  margin: 20px 0;
  text-align: left;
}
.stat-box h5, .stat-box p { text-align: left; }
.stat-box .stat-number {
  font-size: 32px;
  font-weight: 700;
  color: #1a3a5c;
}
.stat-box .stat-label {
  font-size: 14px;
  color: #666;
  margin-top: 5px;
}

/* 表格滚动容器（V330起固化）：表格保持display:table，由外层div负责横向滚动，
   避免display:block导致表框与列网格分离出现右侧空白列 */
.tbl-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* 手机端适配：压缩字号与内边距，列最小宽保留（超出由.tbl-scroll横向滚动） */
@media (max-width: 768px) {
  table { font-size: 12px; }
  td, th { padding: 6px 4px; }
  .content { padding: 10px; }
}

/* 打印/PDF（V332起固化，刊物级排版）：A4、表格不裁剪、分页控制、保留封面底色 */
@page { size: A4; margin: 13mm 11mm; }
@media print {
  html, body { background: #fff !important; }
  body { font-size: 10.5pt; line-height: 1.65; }
  .nav-bar, .backtop, .progress-bar, .cover-pdf, .cover-archive, .footer-archive { display: none !important; }
  .cover, .footer { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  /* 封面/封底不单独成页（V333起固化，2026-08-10用户确认）：作为深色横幅自然按序拼接 */
  .cover { min-height: auto; padding: 36px 30px; margin-bottom: 14pt; }
  /* AI声明低调化 + 摘要区顶部留白压缩（V334起固化，2026-08-10用户确认） */
  .ai-statement { font-size: 8.5pt; color: #999; padding: 6pt 10pt; border-left: 2px solid #c9dcf2; background: none; margin-bottom: 10pt; }
  .ai-statement strong { color: #888; }
  .summary-section { padding: 14pt 16pt 12pt; }
  .summary-section h2 { margin-top: 0; }
  .summary-box { box-shadow: none; border: 1px solid #e3ecf7; }
  .footer { margin-top: 24pt; }
  .content { max-width: none !important; width: 100% !important; padding: 0 !important; }
  /* 打印时取消横向滚动，表格全宽显示，防止内容被裁剪 */
  .tbl-scroll { overflow: visible !important; }
  table { width: 100% !important; font-size: 8.6pt; table-layout: auto; }
  th, td { padding: 4px 6px !important; word-break: break-word; }
  td.td-vendor, th.th-vendor { min-width: 5em; }
  tr, .item, .stat-box { page-break-inside: avoid; }
  h2, h3, h4 { page-break-after: avoid; }
  h2 { page-break-before: always; }
  h2:first-of-type { page-break-before: auto; }
  a { color: #1a56a8; text-decoration: none; }
}
</style>
</head>
